#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source /usr/share/yunohost/helpers

#=================================================
# STOP SYSTEMD SERVICE
#=================================================
ynh_script_progression "Stopping $app's systemd service..."

ynh_systemctl --service="$app" --action="stop"

#=================================================
# BUILD DRIVERS
#=================================================
if [ "$node_type" == "client" ] && [ "$driver_lxc" -eq 1 ]; then
    ynh_script_progression "Installing Go..."
    ynh_go_install

    ynh_script_progression "Building LXC driver..."
    ynh_setup_source --dest_dir="$install_dir/driver_lxc" --source_id="driver_lxc"
    pushd "$install_dir/driver_lxc"
        export GOPATH="$install_dir/driver_lxc/go"
        export GOCACHE="$install_dir/driver_lxc/.cache"
        ynh_hide_warnings go build
    popd
    mv -f "$install_dir/driver_lxc/nomad-driver-lxc" "$data_dir/plugins/nomad-driver-lxc"
    ynh_safe_rm "$install_dir/driver_lxc"
fi

#=================================================
# UPDATE A CONFIG FILE
#=================================================
ynh_script_progression "Updating configuration..."

mkdir -p "$config_path"

ynh_config_add --template="nomad.hcl" --destination="$config_path/nomad.hcl"

if [ "$node_type" == "server" ]; then
    ynh_config_add --template="server.hcl" --destination="$config_path/server.hcl"
fi

if [ "$node_type" == "client" ]; then
    ynh_config_add --template="client.hcl" --destination="$config_path/client.hcl"

    if [ "$driver_lxc" -eq 1 ]; then
        ynh_config_add --template="driver-lxc.hcl" --destination="$config_path/driver-lxc.hcl"
    fi
fi

chmod -R go-rwx,u-w "$config_path"
chown -R "$app:$app" "$config_path"

#=================================================
# REAPPLY SYSTEM CONFIGURATIONS
#=================================================
ynh_script_progression "Upgrading system configurations related to $app..."

# Create a dedicated NGINX config
ynh_config_add_nginx

# Create a dedicated systemd config
case "$node_type" in
    client) systemd_user="root" ;;
    server) systemd_user="$app" ;;
esac
ynh_config_add_systemd
yunohost service add "$app" --log="/var/log/$app/$app.log" --needs_exposed_ports "$port_rpc" "$port_serf"

# Use logrotate to manage app-specific logfile(s)
ynh_config_add_logrotate

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

ynh_systemctl --service="$app" --action="start"  --wait_until="Nomad agent started"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Upgrade of $app completed"
