#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source /usr/share/yunohost/helpers

#=================================================
# INITIALIZE AND STORE SETTINGS
#=================================================

client_lxc_bridge="lxcbr0"
client_lxc_plage_ip="10.1.44"
client_lxc_main_iface=$(ip route | grep default | awk '{print $5;}')
ynh_app_setting_set --key=client_lxc_bridge --value="$client_lxc_bridge"
ynh_app_setting_set --key=client_lxc_plage_ip --value="$client_lxc_plage_ip"
ynh_app_setting_set --key=client_lxc_main_iface --value="$client_lxc_main_iface"

#=================================================
# CREATE DATA DIRECTORY
#=================================================
ynh_script_progression "Configuring the data directory..."

chmod -R o-rwx "$data_dir"
chown -R "$app:$app" "$data_dir"

#=================================================
# BUILD DRIVERS
#=================================================

if [ "$node_type" == "client" ] && [ "$driver_lxc" -eq 1 ]; then

    ynh_script_progression "Building LXC driver..."
    ynh_setup_source --dest_dir="$install_dir/driver_lxc" --source_id="driver_lxc"
    pushd "$install_dir/driver_lxc"
        export GOPATH="$install_dir/driver_lxc/go"
        export GOCACHE="$install_dir/driver_lxc/.cache"
        ynh_hide_warnings go build
    popd
    mv -f "$install_dir/driver_lxc/nomad-driver-lxc" "$data_dir/plugins/nomad-driver-lxc"
    ynh_safe_rm "$install_dir/driver_lxc"
fi

#=================================================
# ADD A CONFIGURATION
#=================================================
ynh_script_progression "Adding $app's configuration..."

config_path=/etc/$app.d
ynh_app_setting_set --key=config_path --value="$config_path"

mkdir -p "$config_path"

ynh_config_add --template="nomad.hcl" --destination="$config_path/nomad.hcl"

if [ "$node_type" == "server" ]; then
    ynh_config_add --template="server.hcl" --destination="$config_path/server.hcl"
fi

if [ "$node_type" == "client" ]; then
    ynh_config_add --template="client.hcl" --destination="$config_path/client.hcl"

    if [ "$driver_lxc" -eq 1 ]; then
        ynh_config_add --template="driver-lxc.hcl" --destination="$config_path/driver-lxc.hcl"
        ynh_config_add --template="dnsmasq-lxd" --destination="/etc/dnsmasq.d/lxd"
        systemctl restart dnsmasq

        if ynh_in_ci_tests; then
            ynh_config_add --template="lxc-net" --destination="/etc/default/lxc-net"
        fi
        ynh_config_add --template="default.conf" --destination="/etc/lxc/default.conf"
        systemctl enable lxc-net --quiet
        ynh_systemctl --service=lxc-net --action="restart" --wait_until="Finished LXC network bridge setup" --log_path="systemd"
    fi
fi

chmod -R go-rwx,u-w "$config_path"
chown -R "$app:$app" "$config_path"

#=================================================
# SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Adding system configurations related to $app..."

# Create a dedicated NGINX config
ynh_config_add_nginx

# Create a dedicated systemd config
case "$node_type" in
    client) systemd_user="root" ;;
    server) systemd_user="$app" ;;
esac

ynh_config_add_systemd
yunohost service add "$app" --log="/var/log/$app/$app.log" --needs_exposed_ports "$port_rpc" "$port_serf"

# Use logrotate to manage application logfile(s)
ynh_config_add_logrotate

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

# Start a systemd service
ynh_systemctl --service="$app" --action="start" --wait_until="Nomad agent started"

chmod -R go-rwx,u-w "$config_path"
chown -R "$app:$app" "$config_path"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Installation of $app completed"
